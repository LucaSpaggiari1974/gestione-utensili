/*
  Cloudflare Pages headers: allow reliable cross-origin image loading.
*/
/assets/*
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin

/*
  Keep HTML and JSON fresh after a deployment while preserving normal browser caching.
*/
/index.html
  Cache-Control: no-cache
/catalog.json
  Cache-Control: no-cache
